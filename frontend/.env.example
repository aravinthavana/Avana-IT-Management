# ==============================================================================
# Frontend Environment Configuration Example
# Copy this file to frontend/.env and replace placeholders with your actual values.
# NEVER commit the actual frontend/.env file to version control.
# ==============================================================================

# Microsoft 365 / Azure AD Single Sign-On (Client Application)
VITE_AZURE_CLIENT_ID=your-azure-ad-app-client-id
VITE_AZURE_TENANT_ID=your-azure-ad-tenant-id

# Backend API Endpoint URL
VITE_API_URL=http://localhost:8080
