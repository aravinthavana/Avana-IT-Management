# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to backend/.env and replace placeholders with your actual values.
# NEVER commit the actual backend/.env file to version control.
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://your_db_user:your_secure_db_password@localhost:5432/avana_it_db?schema=public"

# Server Port
PORT=8080

# Environment Mode (development | production)
NODE_ENV=development

# JWT Secret Key (Generate a cryptographically secure random string, minimum 32 characters)
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# Microsoft 365 / Azure AD Single Sign-On
AZURE_CLIENT_ID="your-azure-ad-app-client-id"
AZURE_TENANT_ID="your-azure-ad-tenant-id"

# Allowed CORS Origin (Frontend URL)
FRONTEND_URL="http://localhost:5173"
