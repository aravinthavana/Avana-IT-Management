generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  password     String?
  role         String       @default("User")
  status       String       @default("Active")
  departmentId Int?
  branchId     Int?
  managerId    Int?
  avatar       String?
  mobile       String?
  jobTitle     String?
  company      String?
  employeeId   String?
  accountType  String       @default("Employee")
  laptopStatus String?      // e.g. "Using own laptop", "No laptop assigned", "Details not collected"
  location     String?      // Work Location station/city e.g. "Hyderabad", "Pune", "Remote"
  workAddress  String?      // Office premises / street address e.g. "No.91, Sundar Nagar" or "Field"
  city         String?      // Office / station city
  state        String?      // Office / station state
  postalCode   String?      // Office / station postal code
  country      String?      // Country e.g. "India"
  
  // IT Operations - Onboarding Checklist
  m365AccountCreated       Boolean   @default(false)
  m365LicenseAssigned      Boolean   @default(false)
  softwareInstalled        Boolean   @default(false)
  hardwareTested           Boolean   @default(false)
  credentialsHandedOver    Boolean   @default(false)
  dispatchDetails          String?   // JSON: address, courier, docketNo, dispatchDate, trackingUrl, remarks
  onboardingStatus         String?   @default("Pending") // "Pending", "In Progress", "Completed", "Not Required"
  onboardingCompletedDate  DateTime?
  onboardingStep           Int?      @default(1)

  // IT Operations - Offboarding Checklist
  assetReturned            Boolean   @default(false)
  assetReturnCondition     String?   // "Good", "Minor Damage", "Major Damage", "Non-functional"
  assetReturnRemarks       String?
  assetReturnDocket        String?   // JSON: courier, docketNo, returnDate
  deviceWiped              Boolean   @default(false)
  dataBackedUp             Boolean   @default(false)
  m365LicenseRevoked       Boolean   @default(false)
  m365AccountDisabled      Boolean   @default(false)
  offboardingStatus        String?   @default("Pending") // "Pending", "In Progress", "Completed"
  offboardingCompletedDate DateTime?
  department   Department?  @relation(fields: [departmentId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  manager      User?        @relation("UserManager", fields: [managerId], references: [id])
  subordinates User[]       @relation("UserManager")
  
  assets       Asset[]      // When assigneeType == "User"
  histories    AssetHistory[]
  licenseAssignments LicenseAssignment[]
  assetRequests AssetRequest[] @relation("UserRequests")
  managedRequests AssetRequest[] @relation("ManagerRequests")
  tickets         SupportTicket[] @relation("UserTickets")
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  kbArticles   KnowledgeBase[]
  handovers    HandoverLog[]
  selfAudits       SelfAudit[]     @relation("UserSelfAudits")
  requestedAudits  SelfAudit[]     @relation("AuditRequestedBy")
  reviewedAudits   SelfAudit[]     @relation("AuditReviewedBy")
  declarations     AssetDeclaration[] @relation("UserDeclarations")
  reconciledDeclarations AssetDeclaration[] @relation("DeclarationReconciledBy")
  ticketComments TicketComment[]
  accessories  UserAccessory[]


  @@index([departmentId])
  @@index([branchId])
  @@index([managerId])
  @@index([status])
}

model Department {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
}

model Branch {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  location String?
  users    User[]
}

model Asset {
  id                Int       @id @default(autoincrement())
  assetId           String    @unique
  name              String
  category          String
  status            String    @default("In Stock")
  condition         String?   @default("Good")
  
  // Logical assignee tracking (can be User, Department, or Branch)
  assigneeId        Int?
  assigneeType      String?   

  // Direct foreign key (used when assigned to User)
  userId            Int?
  user              User?     @relation(fields: [userId], references: [id])
  
  company           String?
  brand             String?
  model             String?
  serialNumber      String?
  location          String?
  
  purchaseId        Int?
  purchase          PurchaseRecord? @relation(fields: [purchaseId], references: [id])

  warrantyType      String?   @default("None")
  warrantyStartDate DateTime?
  warrantyYears     String?
  warrantyEndDate   DateTime?
  
  remarks           String?
  specs             String?
  lastAuditedAt     DateTime?

  histories         AssetHistory[]
  licenseAssignments LicenseAssignment[]
  handovers         HandoverLog[]
  selfAudits        SelfAudit[]
  supportTickets    SupportTicket[]
  requestsAsCurrent AssetRequest[] @relation("RequestCurrentAsset")
  requestsAsAllocated AssetRequest[] @relation("RequestAllocatedAsset")

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([company])
  @@index([purchaseId])
}

model AssetHistory {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  event     String
  details   String?
  condition String?  // Condition of the asset at the time of the event

  @@index([assetId])
  @@index([userId])
}

model HandoverLog {
  id           Int      @id @default(autoincrement())
  assetId      Int
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  handoverDate DateTime @default(now())
  signature    String?  // Base64 signature image string
  status       String   @default("Pending") // Pending, Signed, Rejected
  condition    String?  // Condition at issue

  @@index([assetId])
  @@index([userId])
  @@index([status])
}

model PurchaseRecord {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  poNumber      String?
  purchaseDate  DateTime
  vendor        String?
  amount                 Float?
  invoiceAttachmentUrl   String?
  invoiceAttachmentFilename String?
  poAttachmentUrl        String?
  poAttachmentFilename   String?
  assets                 Asset[]
  accessoryBatches       AccessoryBatch[]
}


model License {
  id             Int       @id @default(autoincrement())
  name           String
  category       String
  key            String?
  seats          Int       @default(1)
  startDate      DateTime? 
  expirationDate DateTime? 
  cost           Float?
  status         String    @default("Active") // Active, Expiring Soon, Expired, Cancelled
  remarks        String?

  assignments    LicenseAssignment[]
}

model LicenseAssignment {
  id           Int      @id @default(autoincrement())
  licenseId    Int
  license      License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  
  assetId      Int?
  asset        Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  assignedAt   DateTime @default(now())

  @@index([licenseId])
  @@index([userId])
  @@index([assetId])
}

model AssetRequest {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation("UserRequests", fields: [userId], references: [id])
  
  managerId         Int?
  manager           User?     @relation("ManagerRequests", fields: [managerId], references: [id])
  
  requestType       String    // "New Asset", "Replacement", "Upgrade", "Repair"
  category          String    // "Laptop", "Desktop", "Monitor", "Keyboard", "Mouse", "Headset", "Software License", "Other"
  priority          String    @default("Medium") // "Low", "Medium", "High", "Urgent"
  description       String?
  
  // Existing asset if Replacement/Upgrade/Repair
  currentAssetId    Int?
  currentAsset      Asset?    @relation("RequestCurrentAsset", fields: [currentAssetId], references: [id], onDelete: SetNull)
  
  // Real allocated asset when Admin fulfills
  allocatedAssetId  Int?
  allocatedAsset    Asset?    @relation("RequestAllocatedAsset", fields: [allocatedAssetId], references: [id], onDelete: SetNull)
  
  status            String    @default("Pending Manager") // Pending Manager, Pending Admin, Approved, Fulfilled, Rejected by Manager, Rejected by Admin
  rejectionReason   String?
  managerRemarks    String?
  adminRemarks      String?
  
  managerDecisionAt DateTime?
  adminDecisionAt   DateTime?
  fulfilledAt       DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([managerId])
  @@index([allocatedAssetId])
  @@index([currentAssetId])
}

model SupportTicket {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation("UserTickets", fields: [userId], references: [id])
  
  assignedToId    Int?
  assignedTo      User?    @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolutionNotes String?
  
  subject         String
  category        String   // Hardware, Software, Email, Network, Account, Other
  priority        String   @default("Medium") // Low, Medium, High, Urgent
  status          String   @default("Open")   // Open, In Progress, Waiting on User, Waiting on Vendor, Resolved, Closed
  description     String
  attachments     String?  // JSON Array: [{ url, name, size, type }]
  
  assetId         Int?
  asset           Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?

  comments        TicketComment[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([assetId])
}

model TicketComment {
  id             Int           @id @default(autoincrement())
  ticketId       Int
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId         Int
  user           User          @relation(fields: [userId], references: [id])
  message        String
  attachments    String?       // JSON Array: [{ url, name, size, type }]
  source         String        @default("Portal") // "Portal" | "Email"
  emailMessageId String?       @unique
  isInternal     Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([ticketId])
  @@index([userId])
}

model KnowledgeBase {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // Troubleshooting, Policy, SOP, FAQ
  content     String   // Markdown content
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([authorId])
}

model SelfAudit {
  id               Int       @id @default(autoincrement())
  assetId          Int
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId           Int
  user             User      @relation("UserSelfAudits", fields: [userId], references: [id])
  
  // IT Admin targeted assignment tracking
  requestedById    Int?
  requestedBy      User?     @relation("AuditRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedAt      DateTime?
  dueDate          DateTime?
  submittedAt      DateTime?
  
  // Admin review & verification tracking
  reviewedById     Int?
  reviewedBy       User?     @relation("AuditReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  
  scannedAssetId   String?
  imageUrl         String?   // Storage URL or Base64 string
  remarks          String?   // General/legacy remarks
  userRemarks      String?   // Employee's remarks upon submission
  adminRemarks     String?   // Reviewer's internal or feedback remarks
  rejectionReason  String?   // Specific reason if audit is rejected
  
  // Structured hardware health checklist
  location         String?   // "Head Office", "Remote / WFH", "Branch / Plant", "Client Site"
  condition        String?   // "Good", "Minor Scratches", "Damaged", "Needs IT Attention"
  hardwareChecks   String?   // JSON string: { screenOk, keyboardOk, batteryOk, chargerOk, bodyOk }
  
  // Optional escalation link to a SupportTicket
  ticketId         Int?
  
  declarations     AssetDeclaration[] @relation("AuditDeclarations")
  
  // Status lifecycle: "Requested" | "Pending Review" | "Approved" | "Rejected"
  status           String    @default("Pending Review")
  auditDate        DateTime  @default(now())

  @@index([assetId])
  @@index([userId])
  @@index([status])
  @@index([requestedById])
  @@index([reviewedById])
}

model AssetDeclaration {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation("UserDeclarations", fields: [userId], references: [id], onDelete: Cascade)
  
  hasAssets        Boolean   // true = Yes, false = No
  selectedTypes    String?   // JSON array: ["Laptop", "Monitor", ...]
  declaredItems    String?   // JSON array: [{ id, name, category, brand, serialNumber, condition, location, imageUrl, isGhost, convertedAssetId }]
  
  systemRecordsOk  Boolean   // true = matches IT records, false = discrepancy
  discrepancyNotes String?   // Employee's explanation of discrepancy
  
  status           String    @default("Pending Review") // "Pending Review", "Reconciled"
  reconciledById   Int?
  reconciledBy     User?     @relation("DeclarationReconciledBy", fields: [reconciledById], references: [id], onDelete: SetNull)
  reconciledAt     DateTime?
  adminRemarks     String?
  
  auditId          Int?
  audit            SelfAudit? @relation("AuditDeclarations", fields: [auditId], references: [id], onDelete: SetNull)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([auditId])
  @@index([reconciledById])
}

model LoginOtp {
  id        Int      @id @default(autoincrement())
  email     String
  otpHash   String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AccessoryBatch {
  id                Int       @id @default(autoincrement())
  name              String    // e.g. "Dell Optical Mouse MS116"
  category          String    // "Mouse", "Keyboard", "Headset", "Monitor", "Pen Drive", "Dock", "Bag", "Adapter", "Other"
  brand             String?
  model             String?
  quantityPurchased Int
  quantityAvailable Int
  purchaseDate      DateTime
  warrantyMonths    Int?      // e.g. 12 (1 yr), 24 (2 yrs), 36 (3 yrs)
  warrantyEndDate   DateTime?
  vendor            String?
  invoiceNumber     String?
  unitCost          Float?
  
  purchaseRecordId  Int?
  purchaseRecord    PurchaseRecord? @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)

  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assignments       UserAccessory[]

  @@index([category])
  @@index([purchaseDate])
}

model UserAccessory {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  batchId         Int?
  batch           AccessoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  category        String    // "Mouse", "Keyboard", "Headset", "Monitor", "Pen Drive", "Dock", "Bag", "Adapter", "Other"
  name            String
  brand           String?
  serialNumber    String?
  purchaseDate    DateTime?
  warrantyEndDate DateTime?
  condition       String?   @default("Good")
  assignedAt      DateTime  @default(now())
  returnedAt      DateTime?
  status          String    @default("Assigned") // "Assigned", "Returned"
  notes           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([batchId])
  @@index([status])
}


