generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  password     String?
  role         String       @default("User")
  status       String       @default("Active")
  departmentId Int?
  branchId     Int?
  managerId    Int?
  avatar       String?
  mobile       String?
  jobTitle     String?
  company      String?
  employeeId   String?
  accountType  String       @default("Employee")
  laptopStatus String?      // e.g. "Using own laptop", "No laptop assigned", "Details not collected"
  location     String?      // Work Location e.g. "Hyderabad", "Pune", "Remote"
  department   Department?  @relation(fields: [departmentId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  manager      User?        @relation("UserManager", fields: [managerId], references: [id])
  subordinates User[]       @relation("UserManager")
  
  assets       Asset[]      // When assigneeType == "User"
  histories    AssetHistory[]
  licenseAssignments LicenseAssignment[]
  assetRequests AssetRequest[] @relation("UserRequests")
  managedRequests AssetRequest[] @relation("ManagerRequests")
  tickets      SupportTicket[]
  kbArticles   KnowledgeBase[]
  handovers    HandoverLog[]
  selfAudits   SelfAudit[]
  ticketComments TicketComment[]

  @@index([departmentId])
  @@index([branchId])
  @@index([managerId])
  @@index([status])
}

model Department {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  users  User[]
}

model Branch {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  location String?
  users    User[]
}

model Asset {
  id                Int       @id @default(autoincrement())
  assetId           String    @unique
  name              String
  category          String
  status            String    @default("In Stock")
  
  // Logical assignee tracking (can be User, Department, or Branch)
  assigneeId        Int?
  assigneeType      String?   

  // Direct foreign key (used when assigned to User)
  userId            Int?
  user              User?     @relation(fields: [userId], references: [id])
  
  company           String?
  brand             String?
  model             String?
  serialNumber      String?
  location          String?
  
  purchaseId        Int?
  purchase          PurchaseRecord? @relation(fields: [purchaseId], references: [id])

  warrantyType      String?   @default("None")
  warrantyStartDate DateTime?
  warrantyYears     String?
  warrantyEndDate   DateTime?
  
  remarks           String?
  specs             String?

  histories         AssetHistory[]
  licenseAssignments LicenseAssignment[]
  handovers         HandoverLog[]
  selfAudits        SelfAudit[]
  supportTickets    SupportTicket[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([company])
  @@index([purchaseId])
}

model AssetHistory {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  event     String
  details   String?

  @@index([assetId])
  @@index([userId])
}

model HandoverLog {
  id           Int      @id @default(autoincrement())
  assetId      Int
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  handoverDate DateTime @default(now())
  signature    String?  // Base64 signature image string
  status       String   @default("Pending") // Pending, Signed, Rejected

  @@index([assetId])
  @@index([userId])
  @@index([status])
}

model PurchaseRecord {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  poNumber      String?
  purchaseDate  DateTime
  vendor        String?
  amount                 Float?
  invoiceAttachmentUrl   String?
  invoiceAttachmentFilename String?
  poAttachmentUrl        String?
  poAttachmentFilename   String?
  assets                 Asset[]
}

model License {
  id             Int       @id @default(autoincrement())
  name           String
  category       String
  key            String?
  seats          Int       @default(1)
  startDate      DateTime? 
  expirationDate DateTime? 
  cost           Float?
  status         String    @default("Active") // Active, Expiring Soon, Expired, Cancelled
  remarks        String?

  assignments    LicenseAssignment[]
}

model LicenseAssignment {
  id           Int      @id @default(autoincrement())
  licenseId    Int
  license      License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  
  assetId      Int?
  asset        Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  assignedAt   DateTime @default(now())

  @@index([licenseId])
  @@index([userId])
  @@index([assetId])
}

model AssetRequest {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation("UserRequests", fields: [userId], references: [id])
  
  managerId    Int?
  manager      User?    @relation("ManagerRequests", fields: [managerId], references: [id])
  
  requestType  String   // e.g., "New Asset", "Replacement", "Upgrade"
  category     String   // e.g., "Laptop", "Mouse", "Keyboard"
  description  String?
  status       String   @default("Pending Manager") // Pending Manager, Pending Admin, Approved, Rejected
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([managerId])
}

model SupportTicket {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  subject     String
  category    String   // Hardware, Software, Email, Network, Account, Other
  priority    String   @default("Medium") // Low, Medium, High, Urgent
  status      String   @default("Open")   // Open, In Progress, Resolved, Closed
  description String
  
  assetId     Int?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?

  comments    TicketComment[]

  @@index([userId])
  @@index([status])
  @@index([assetId])
}

model TicketComment {
  id        Int           @id @default(autoincrement())
  ticketId  Int
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@index([userId])
}

model KnowledgeBase {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // Troubleshooting, Policy, SOP, FAQ
  content     String   // Markdown content
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([authorId])
}

model SelfAudit {
  id               Int      @id @default(autoincrement())
  assetId          Int
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  scannedAssetId   String?
  imageUrl         String?  // Storage URL or Base64 string
  remarks          String?
  status           String   @default("Pending Review") // Pending Review, Approved, Rejected
  auditDate        DateTime @default(now())

  @@index([assetId])
  @@index([userId])
  @@index([status])
}
