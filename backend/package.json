{
  "name": "avana-it-backend",
  "version": "1.0.0",
  "description": "API for Avana IT Management",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "npx prisma generate && tsc",
    "db:push": "npx prisma db push",
    "sync-users": "ts-node src/syncUsers.ts",
    "wipe-data": "ts-node src/wipeData.ts",
    "test": "node --test tests/security-regressions.test.cjs tests/licensing.test.cjs tests/support-work.test.cjs",
    "db:deploy-support-work": "prisma db execute --file prisma/updates/20261024_support_work.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.5",
    "prisma": "^5.14.0",
    "selfsigned": "^5.5.0",
    "typescript": "^5.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.1",
    "nodemon": "^3.1.2",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "exceljs": { "uuid": "^11.1.1" }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
