# ==============================================================================
# Docker Compose & Root Environment Configuration Example
# Copy this file to .env and replace placeholders with your actual secure values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Database Configuration (PostgreSQL container in docker-compose)
POSTGRES_USER=avana_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=avana_it_db

# Backend Security
JWT_SECRET=replace_with_a_cryptographically_random_secret_at_least_32_chars
FRONTEND_URL=http://localhost:5173

# Microsoft 365 / Azure AD Authentication
AZURE_CLIENT_ID=your_azure_app_client_id_here
AZURE_TENANT_ID=your_azure_tenant_id_here

# Frontend Configuration
VITE_AZURE_CLIENT_ID=your_azure_app_client_id_here
VITE_AZURE_TENANT_ID=your_azure_tenant_id_here
VITE_API_URL=http://localhost:8080
